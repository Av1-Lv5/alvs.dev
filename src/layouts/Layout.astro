---
// This is the base layout designed for differen pages

// components
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import MobileDock from "@components/MobileDock.astro";
import CommandPalette from "@components/CommandPalette.astro";
import PixelStrip from "@components/PixelStrip.astro";
import BaseHead from "@components/BaseHead.astro";
// import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

// Types
type Props = {
  pageTabTitle: string;
  categoryTabTitle: string;
  pageTitle?: string;
  showNav: boolean;
  description?: string;
  image?: string;
};

// styles
import "@styles/minimal.css";
import "@styles/custom.css";

// props
const {
  pageTabTitle,
  pageTitle,
  categoryTabTitle,
  showNav,
  description,
  image,
} = Astro.props;

const fullTitle = `${pageTabTitle} • ${categoryTabTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} />

    <!-- Web analytics -->
    <script
      is:inline
      data-goatcounter="https://a-sh.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>

    <!-- Theme -->
    <script is:inline>
      (function () {
        var LIGHT = "#f3f4f6";
        var DARK = "#090a0c";
        function syncThemeColor(theme) {
          var resolved = theme;
          if (!resolved) {
            resolved = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
          var color = resolved === "light" ? LIGHT : DARK;
          var meta = document.querySelector(
            'meta[name="theme-color"]:not([media])',
          );
          if (!meta) {
            meta = document.createElement("meta");
            meta.setAttribute("name", "theme-color");
            document.head.appendChild(meta);
          }
          meta.setAttribute("content", color);
          // Remove media metas once we have an explicit override so the
          // manual toggle wins over the OS preference.
          document
            .querySelectorAll('meta[name="theme-color"][media]')
            .forEach(function (m) {
              m.remove();
            });
        }
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
            syncThemeColor("dark");
          } else if (theme === "light") {
            document.documentElement.setAttribute("data-theme", "light");
            syncThemeColor("light");
          } else {
            document.documentElement.removeAttribute("data-theme");
            // No override: keep the media-based <meta> tags from BaseHead.
          }
          window.__syncThemeColor = syncThemeColor;
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </head>
  <body>
    <Header title={pageTitle} showNav={showNav} />
    <PixelStrip />
    <main>
      <slot />
    </main>
    <Footer />
    {showNav && <MobileDock />}
    {showNav && <CommandPalette />}
  </body>
</html>
